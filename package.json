{
  "name": "harambeeone",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @harambeeone/web --filter @harambeeone/backend dev",
    "dev:web": "pnpm --filter @harambeeone/web dev",
    "dev:api": "pnpm --filter @harambeeone/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:revision": "pnpm --filter @harambeeone/backend db:revision",
    "db:migrate": "pnpm --filter @harambeeone/backend db:migrate",
    "db:seed": "pnpm --filter @harambeeone/backend db:seed",
    "test:e2e": "playwright test e2e/public-security.spec.ts",
    "test:e2e:auth": "node scripts/verify-e2e-env.mjs auth && playwright test e2e/authenticated-readonly.spec.ts",
    "test:e2e:mutating": "node scripts/verify-e2e-env.mjs mutations && playwright test e2e/mutating"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
