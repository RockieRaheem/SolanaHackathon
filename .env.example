# Shared
NODE_ENV=development

# Web
API_URL=http://localhost:4100
# Deprecated browser-visible fallback; use API_URL for new deployments.
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Python API
PORT=4100
# Copy the Session pooler URI from Supabase Connect and URL-encode the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-side Google AI Studio auth key. Never expose it in NEXT_PUBLIC_*.
GEMINI_API_KEY=
# The application intentionally accepts only this reviewed Gemma model.
GEMMA_MODEL=gemma-4-26b-a4b-it
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=replace-me-in-production

# Messaging / language integrations (optional)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
SUNBIRD_API_KEY=

# Solana hackathon rail (devnet only; never place a private key here)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Fixed demonstration quote used only to translate a UGX pledge into devnet SOL.
NEXT_PUBLIC_SOLANA_DEMO_UGX_PER_SOL=750000
# Server-only verification settings. Use a dedicated RPC provider in production.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_DEMO_UGX_PER_SOL=750000
SOLANA_INTENT_TTL_MINUTES=30
SOLANA_EXPLORER_BASE_URL=https://explorer.solana.com
SOLANA_MAINNET_ENABLED=false
